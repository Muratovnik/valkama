{
  "printWidth": 100,
  "proseWrap": "always",
  "htmlWhitespaceSensitivity": "css",
  "quoteProps": "consistent",
  "requirePragma": false,
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
