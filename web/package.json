{
  "name": "valkama-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "test": "npm run lint && npm run check:ui-system && npm run check:tokens && npm run lint:dead && npm run lint:dup && npm run test:unit",
    "lint": "npm run lint:types && npm run lint:js && npm run lint:css && npm run lint:format",
    "lint:dead": "knip --no-progress",
    "lint:dup": "jscpd -t 1",
    "lint:types": "oxlint --type-aware src scripts tests",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"**/*.{css,vue}\"",
    "lint:format": "prettier --check .",
    "format": "eslint . --fix && prettier --write . && stylelint --fix \"src/**/*.{css,vue}\"",
    "check:ui-system": "node scripts/check-ui-system.mjs",
    "check:tokens": "node scripts/sync-tokens.mjs --check",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test",
    "typecheck": "vue-tsc --build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.66.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "elkjs": "0.12.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@csstools/css-tokenizer": "^4.0.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/sortablejs": "^1.15.8",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-oxlint": "^1.90.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vue-scoped-css": "^3.1.3",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "postcss-selector-parser": "^7.1.7",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "stylelint-use-nesting": "^6.0.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  }
}
