{
  "name": "valkama-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "test": "npm run lint && npm run check:ui-system && npm run check:tokens && npm run lint:dead && npm run lint:dup && npm run test:unit",
    "lint": "npm run lint:types && npm run lint:js && npm run lint:css && npm run lint:format",
    "lint:dead": "knip --no-progress",
    "lint:dup": "jscpd -t 1",
    "lint:types": "oxlint --type-aware src scripts tests",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"**/*.{css,vue}\"",
    "lint:format": "prettier --check .",
    "format": "eslint . --fix && prettier --write . && stylelint --fix \"src/**/*.{css,vue}\"",
    "check:ui-system": "node scripts/check-ui-system.mjs",
    "check:tokens": "node scripts/sync-tokens.mjs --check",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test",
    "typecheck": "vue-tsc --build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.31.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "echarts": "^6.1.0",
    "markdown-it": "^14.3.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.1",
    "sortablejs": "^1.15.6",
    "vue": "^3.5.40",
    "vue-echarts": "^8.1.0",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@csstools/css-tokenizer": "^4.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.4.1",
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@types/sortablejs": "^1.15.8",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-oxlint": "^1.78.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vue-scoped-css": "^3.1.3",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "jscpd": "^5.0.15",
    "knip": "^6.32.2",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.23",
    "postcss-html": "^2.0.0",
    "postcss-selector-parser": "^7.1.5",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-use-nesting": "^6.0.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.0.0"
  }
}
